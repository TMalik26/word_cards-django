# ============================================
# DJANGO CORE SETTINGS
# ============================================

# Django secret key for session encryption
# Generate a new key for production: python manage.py shell
# >>> from django.core.management.utils import get_random_secret_key
# >>> print(get_random_secret_key())
SECRET_KEY=your-super-secret-key-change-in-production

# Debug mode for development: True
# For production: False
DEBUG=True

# Allowed hosts for access (comma-separated)
# For local development: localhost,127.0.0.1
# For production add your domain
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# DATABASE SETTINGS
# ============================================

# Строка подключения к БД
# For local development: sqlite:///db.sqlite3
# For production (PostgreSQL): postgres://user:password@localhost:5432/word_cards_db
# For production (MySQL): mysql://user:password@localhost:3306/word_cards_db
DATABASE_URL=sqlite:///db.sqlite3

# ============================================
# GOOGLE OAUTH2 AUTHENTICATION
# ============================================

# Google OAuth2 Client ID
# Get it at: https://console.cloud.google.com/
# 1. Create a project in the Google Cloud Console
# 2. Enable Google+ API
# 3. Create an OAuth 2.0 Client ID (Web application)
# 4. Add Authorized redirect URIs: http://localhost:8000/accounts/google/login/callback/
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-oauth2-key.apps.googleusercontent.com

# Google OAuth2 Client Secret
# Get it together with the CLIENT ID from the Google Cloud Console
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-oauth2-secret

# ============================================
# ALLAUTH/SOCIALACCOUNT SETTINGS
# ============================================

# Allow email-based authentication (if allauth is used)
# True - users can log in with email
# False - only username is used
SOCIALACCOUNT_EMAIL_AUTHENTICATION=True

# Automatically connect social account with existing email
# True - if email exists, automatically connect accounts
# False - requires user confirmation
SOCIALACCOUNT_EMAIL_AUTHENTICATION_AUTO_CONNECT=True

# Require unique email addresses in the system
# True - each email can be used only once
# False - multiple accounts can have the same email
ACCOUNT_UNIQUE_EMAIL=True

# Automatically associate social account by email
# True - if email matches, automatically associate
# False - requires user confirmation
SOCIAL_AUTH_ASSOCIATE_BY_EMAIL=True

# ============================================
# EMAIL SETTINGS (for sending emails)
# ============================================

# SMTP host for sending emails
# Gmail: smtp.gmail.com
# Yandex: smtp.yandex.ru
# Mail.ru: smtp.mail.ru
EMAIL_HOST=smtp.gmail.com

# SMTP port
# TLS: 587
# SSL: 465
EMAIL_PORT=587

# Use TLS for encryption
# True - for ports 587
# False - for ports 465 (use EMAIL_USE_SSL instead)
EMAIL_USE_TLS=True

# Sender's email address (your Gmail)
# If you use two-factor authentication in Gmail,
# use App Password instead of your regular password
EMAIL_HOST_USER=your-email@gmail.com

# Password for sender's email address
# FOR GMAIL:
# 1. If 2FA is enabled, create an App Password: https://myaccount.google.com/apppasswords
# 2. Use a 16-character App Password
# 3. If 2FA is not enabled, use your regular password
EMAIL_HOST_PASSWORD=your-app-password-or-regular-password